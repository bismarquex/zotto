  <div class="container pt-5 my-5">
    <div class="row">
      <div class="col-lg-6 mb-4">
        <h1>Evolução dos Computadores</h1>
        <p class="text-justify">
          De acordo com Souza, a história dos computadores é marcada por constantes avanços tecnológicos e é dividida em
          quatro gerações principais:
          <br><strong>Primeira Geração (1951-1959):</strong> Utilizavam válvulas eletrônicas, eram grandes, consumiam muita
          energia e tinham uso restrito. Exemplo: ENIAC.
          <br><strong>Segunda Geração (1959-1965):</strong> Substituição das válvulas por transistores, o que tornou os
          computadores mais eficientes e incentivou o uso comercial.
          <br><strong>Terceira Geração (1965-1975):</strong> Uso de circuitos integrados, diminuição do tamanho e aumento da
          capacidade de processamento. Surgem os primeiros chips e os computadores pessoais.
          <br><strong>Quarta Geração (1975 - atual):</strong> Inclusão dos microprocessadores, maior velocidade, menor consumo
          de energia e disseminação dos computadores pessoais.
          <br>A partir dos anos 2000, surgem dispositivos móveis como smartphones e tablets. Alguns estudiosos consideram
          uma <strong>quinta geração</strong>, marcada por supercomputadores, inteligência artificial, robótica e avanços da
          internet.
          <br>A evolução dos computadores, que antes era lenta, se tornou muito rápida com o avanço da ciência e da
          comunicação (Souza - 2025).
        </p>
      </div>

      <div class="col-lg-6 mb-4">
        <h1 class="text-center">Quiz - Evolução dos Computadores</h1>
        <div class="quiz-container">
          <div id="quiz"></div>
          <div class="navigation-buttons">
            <button id="prevBtn">Anterior</button>
            <button id="nextBtn">Próximo</button>
          </div>
        </div>
        <div class="result-container" id="result"></div>

        <div class="text-center generation-image">
          <h2>Todas as Gerações</h2>
          <img src="imagens/todasgeracoes.png" class="img-fluid" alt="Eniac">
        </div>
      </div>
    </div>
  </div>
  <footer id="footer">
    <p>Universidade Cruzeiro do Sul - Mestrado em Ensino de Ciências e Matemática</p>
    <p>Mestranda: Lúcia Helena Zotto de Moura - Orientador: Prof. Dr. Alex Paubel Junger</p>
  </footer>

  <script>
    const quizData = [{
        question: "Qual tecnologia foi utilizada na Primeira Geração de computadores?",
        options: ["Transistores", "Válvulas eletrônicas", "Circuitos integrados", "Microprocessadores"],
        answer: "Válvulas eletrônicas"
      },
      {
        question: "Em que período ocorreu a Segunda Geração dos computadores?",
        options: ["1951-1959", "1959-1965", "1965-1975", "1975-atual"],
        answer: "1959-1965"
      },
      {
        question: "O que substituiu as válvulas eletrônicas na Segunda Geração?",
        options: ["Circuitos integrados", "Transistores", "Microprocessadores", "Chips"],
        answer: "Transistores"
      },
      {
        question: "Qual foi a principal inovação da Terceira Geração de computadores?",
        options: ["Uso de transistores", "Uso de válvulas eletrônicas", "Uso de circuitos integrados",
          "Inclusão de microprocessadores"
        ],
        answer: "Uso de circuitos integrados"
      },
      {
        question: "Quando surgiram os primeiros computadores pessoais?",
        options: ["Primeira Geração", "Segunda Geração", "Terceira Geração", "Quarta Geração"],
        answer: "Terceira Geração"
      },
      {
        question: "Qual tecnologia marcou a Quarta Geração dos computadores?",
        options: ["Válvulas eletrônicas", "Transistores", "Circuitos integrados", "Microprocessadores"],
        answer: "Microprocessadores"
      },
      {
        question: "A partir de que anos surgiram os dispositivos móveis como smartphones e tablets?",
        options: ["1975", "1980", "1990", "Anos 2000"],
        answer: "Anos 2000"
      },
      {
        question: "O que caracteriza a Quinta Geração de computadores, segundo alguns estudiosos?",
        options: ["Válvulas eletrônicas", "Transistores", "Microprocessadores",
          "Supercomputadores e Inteligência Artificial"
        ],
        answer: "Supercomputadores e Inteligência Artificial"
      },
      {
        question: "Qual o exemplo de computador da Primeira Geração citado no texto?",
        options: ["ENIAC", "UNIVAC", "IBM PC", "Apple II"],
        answer: "ENIAC"
      },
      {
        question: "Segundo Souza, como se tornou a evolução dos computadores?",
        options: ["Mais lenta", "Mais rápida", "Inalterada", "Imprevisível"],
        answer: "Mais rápida"
      }
    ];

    const quiz = document.getElementById("quiz");
    const result = document.getElementById("result");
    const prevBtn = document.getElementById("prevBtn");
    const nextBtn = document.getElementById("nextBtn");

    let currentQuestion = 0;
    let score = 0;
    let selectedAnswer = null;

    function loadQuestion() {
      const questionData = quizData[currentQuestion];
      const optionsHtml = questionData.options.map((option, index) =>
        `<button class="option" data-index="${index}">${option}</button>`
      ).join("");

      quiz.innerHTML = `
        <div class="question">${currentQuestion + 1}. ${questionData.question}</div>
        <div class="options-container">${optionsHtml}</div>
      `;

      const options = document.querySelectorAll(".option");
      options.forEach(option => {
        option.addEventListener("click", () => selectAnswer(option));
      });
    }

    function selectAnswer(option) {
      selectedAnswer = option.textContent;
      resetOptionBackgrounds();
      option.style.backgroundColor = "#00BFFF";
    }

    function resetOptionBackgrounds() {
      const options = document.querySelectorAll(".option");
      options.forEach(option => {
        option.style.backgroundColor = "#1E90FF";
      });
    }

    function checkAnswer() {
      if (selectedAnswer === quizData[currentQuestion].answer) {
        score++;
      }
    }

    function showResult() {
      quiz.style.display = "none";
      prevBtn.style.display = "none";
      nextBtn.style.display = "none";
      result.innerHTML = `Você acertou ${score} de ${quizData.length} perguntas!`;
    }

    function nextQuestion() {
      checkAnswer();
      if (currentQuestion < quizData.length - 1) {
        currentQuestion++;
        loadQuestion();
        selectedAnswer = null;
      } else {
        showResult();
      }
    }

    function prevQuestion() {
      if (currentQuestion > 0) {
        currentQuestion--;
        loadQuestion();
        selectedAnswer = null;
      }
    }

    loadQuestion();
    nextBtn.addEventListener("click", nextQuestion);
    prevBtn.addEventListener("click", prevQuestion);
  </script>

</body>

</html>