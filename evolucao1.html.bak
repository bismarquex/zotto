      font-size: 25px;
    }

    .text-justify {
      text-align: justify;
    }

    #footer {
      width: 100%;
      background-color: #2C3E50;
      color: #ECF0F1;
      padding: 20px 0;
      text-align: center;
      font-size: 30px;
    }

    iframe {
      max-width: 100%;
    }

