    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-4Q6Gf2aSP4eDXB8Miphtr37CMZZQ5oXLH2yaXMJ2w8e2ZtHTl7GptT4jmndRuHDT" crossorigin="anonymous">
 <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js" integrity="sha384-j1CDi7MgGQ12Z7Qab0qlWQ/Qqz24Gc6BM0thvEMVjHnfYGF0rmFCozFSxQBxwHKO" crossorigin="anonymous"></script><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <style>
        body {
            font-family: "Agency FB", sans-serif;
            background-color: #1E1E2F;
            color: #ECF0F1;
            font-size: 24px;
        }

        h1 {
            color: #1E90FF;;
            text-align: center;
        }

        a {
            color: #F39C12;
        }

        .navbar,
        .offcanvas {
            background-color: #2C3E50 !important;
            font-size: 25px;
        }

        .text-justify {
            text-align: justify;
        }

        /* Imagens responsivas */
        .img-fluid {
            max-width: 100%;
            height: auto;
            display: block;
            margin: 10px auto;
			border-radius: 10px;
        }

        #footer {
            width: 100%;
            background-color: #2C3E50;
            color: #ECF0F1;
            padding: 20px 0;
            text-align: center;
            position: relative;
            bottom: 0;
            font-size: 30px;
        }

        /* Estilos para o iframe */
        #iframeJogo {
            width: 100%;
            height: 500px;
            border: none;
        }

        .carta {
            width: 150px;
            height: 100px;
            background-color: #434354;
            border: 1px solid #61616F;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 0.8em;
            cursor: pointer;
            margin: 5px;
            float: left;
            text-align: center;
            position: relative;
            perspective: 1000px;
        }

        .carta-interna {
            position: relative;
            width: 100%;
            height: 100%;
            text-align: center;
            transition: transform 0.6s;
            transform-style: preserve-3d;
        }

        .carta.virada .carta-interna {
            transform: rotateY(180deg);
        }

        .carta-frente,
        .carta-verso {
            position: absolute;
            width: 100%;
            height: 100%;
            -webkit-backface-visibility: hidden;
            backface-visibility: hidden;
            display: flex;
            justify-content: center;
            align-items: center;
            border-radius: 5px;
        }

        .carta-frente {
            background-color: #434354;
            color: #F5F5F5;
        }

        .carta-verso {
            background-color: #fff;
            color: #333;
            transform: rotateY(180deg);
        }

        .carta-verso img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            border-radius: 5px;
        }

        #tabuleiro {
            width: fit-content;
            margin: 20px auto;
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
        }

        
        p {
            text-align: center;
            color: #F5F5F5;
        }

        .conteudo-carta {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 2;
        }

        .imagem-carta {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-size: contain;
            background-repeat: no-repeat;
            background-position: center;
            opacity: 1;
            z-index: 1;
        }

        #mensagem {
            color: #F5F5F5;
            text-align: center;
        }

        .container {
            max-width: 100%;
            padding-left: 10px;
            padding-right: 10px;
        }

        .row {
            margin-left: 0;
            margin-right: 0;
        }

        .col-md-6 {
            padding-left: 10px;
            padding-right: 10px;
        }
    </style>
</head>

